            "expect": {
              "A": 0.45,
              "B": 0.45,
              "C": 0.05,
              "D": 0.05
            }
          }
        ],
        "otherwise": {
          "A": 0.15,
          "B": 0.5,
          "C": 0.2,
          "D": 0.15
        }
      },
      "rule_author": "DRAFT by Claude, to be replaced or confirmed by a person (decision D1)"
    },
