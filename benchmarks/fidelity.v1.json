          {
            "code": "A",
            "label": "The latest flagship model"
          },
          {
            "code": "B",
            "label": "A mid-range model from a well-known brand"
          },
          {
            "code": "C",
            "label": "The cheapest model that does the basics"
          },
          {
            "code": "D",
            "label": "A refurbished or second-hand phone"
          }
        ],
        "randomize": true,
        "maxChoices": null,
        "scale": null,
        "numeric": null
      },
      "source": "human",
      "attribute": "price_sensitivity",
      "rule": {
        "cases": [
          {
            "when": {
              "attribute": "price_sensitivity",
              "min": 4
