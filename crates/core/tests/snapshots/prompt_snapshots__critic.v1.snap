{
  "properties": {
    "flags": {
      "items": {
        "properties": {
          "issue": {
            "enum": [
              "leading",
              "double_barrelled",
              "unclear"
            ],
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "issue",
          "note"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "flags"
  ],
  "type": "object"
}
